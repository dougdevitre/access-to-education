{
  // Markdownlint configuration for Access to Education repo
  // Allow long lines -- documentation often has tables, URLs, and data references
  "MD013": false,

  // Allow inline HTML -- used extensively in markdown files for formatting
  "MD033": false,

  // Allow duplicate headings -- different sections may reuse heading names
  "MD024": false,

  // Allow trailing punctuation in headings -- common in FAQ-style docs
  "MD026": false,

  // Allow multiple top-level headings -- some files have multiple H1s
  "MD025": false,

  // Allow non-standard heading styles
  "MD003": { "style": "consistent" },

  // Allow blanks around fences to be flexible
  "MD031": false,

  // Allow raw URLs in markdown
  "MD034": false,

  // Do not require blank lines around lists
  "MD032": false,

  // Fill-in blanks. The templates and calculators use runs of underscores as
  // write-in blanks ("The ___ is ___.", "Date: ________") and full-width
  // underscore lines as write-in lines in printable forms. markdownlint reads
  // those underscores as emphasis markers and as horizontal rules, so:
  //   MD037 flags every "___ word ___" blank as "spaces inside emphasis", and
  //   --fix would delete the spaces and turn the blanks into bold-italic text;
  //   MD035 flags the write-in lines as a second horizontal-rule style next to
  //   the "---" section dividers, and --fix would turn them into "---".
  // Every hit of both rules in this repo is a blank, so they are off.
  "MD037": false,
  "MD035": false,

  // Template instructions. Forms carry italic parenthetical notes on their own
  // line, such as "*(Copy this section for each goal)*". They are directions to
  // the person filling in the form, not headings, so a line ending in ")" is
  // treated like one ending in "." (MD036's default punctuation list plus ")").
  "MD036": { "punctuation": ".,;:!?)" }
}
